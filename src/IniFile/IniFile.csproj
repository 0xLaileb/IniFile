<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Package Identity -->
    <PackageId>Laileb.IniFile</PackageId>
    <Version>2.1.1</Version>
    <AssemblyVersion>2.1.1.0</AssemblyVersion>
    <FileVersion>2.1.1.0</FileVersion>

    <!-- Description -->
    <Title>IniFile — Windows INI File Wrapper</Title>
    <Description>A lightweight, zero-dependency C# wrapper around the Windows kernel32.dll Private Profile API (WritePrivateProfileString, GetPrivateProfileString, etc.). Provides a strongly-typed interface for reading and writing classic INI configuration files on Windows.</Description>
    <PackageTags>ini;config;configuration;windows;kernel32;pinvoke;inifile</PackageTags>

    <!-- License &amp; URLs -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/0xLaileb/IniFile</PackageProjectUrl>
    <RepositoryUrl>https://github.com/0xLaileb/IniFile</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/0xLaileb/IniFile/releases/tag/2.1.1</PackageReleaseNotes>

    <!-- Icon &amp; README (embedded in .nupkg) -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- XML documentation (for IntelliSense in consumer projects) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Symbol package (.snupkg) for step-through debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- SourceLink (built into the .NET 8+ SDK, no package reference needed) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Catches accidental public API removals: the package is compared with the published baseline
         (downloaded from NuGet during pack). Raise the baseline only for intentional breaking releases. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.1.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Embed icon and README inside the .nupkg -->
  <ItemGroup>
    <None Include="..\..\resources\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
